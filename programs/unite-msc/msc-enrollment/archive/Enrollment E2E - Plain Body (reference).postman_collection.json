        {
          "name": "03 GET Plan by ID",
          "event": [
            {
              "script": {
                "exec": [
                  "pm.test('Plan returns 200', function () { pm.response.to.have.status(200); });",
                  "const j=pm.response.json();",
                  "function f(n){if(!n||typeof n!==\"object\")return null;if(n.fundId)return String(n.fundId);if(Array.isArray(n)){for(var i=0;i<n.length;i++){var x=f(n[i]);if(x)return x;}}var k=Object.keys(n);for(var j=0;j<k.length;j++){var y=f(n[k[j]]);if(y)return y;}return null;}",
                  "var fid=f(j);if(fid){pm.environment.set(\"enrollment.fundId\",fid);pm.collectionVariables.set(\"enrollment.fundId\",fid);}"
                ],
                "type": "text/javascript"
              },
              "listen": "test"
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-app-version",
                "value": "{{x-app-version}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{enrollment.host.url}}/enrollmentapi/v1/plans/{{enrollment.planId}}",
              "host": [
                "{{enrollment.host.url}}"
              ],
              "path": [
                "enrollmentapi",
                "v1",
                "plans",
                "{{enrollment.planId}}"
              ]
            }
          },
          "response": []
        }
      ]
