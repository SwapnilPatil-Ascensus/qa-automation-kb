    {
      "name": "02 - Auth & Prospect",
      "item": [
        {
          "name": "04 POST Create Prospect",
          "event": [
            {
              "script": {
                "exec": [
                  "pm.test('Prospect returns 200', function () { pm.response.to.have.status(200); });",
                  "const body=pm.response.json();",
                  "if(Array.isArray(body)&&body.length){",
                  "  pm.test('No errors',function(){pm.expect(body[0].errors||[]).to.eql([]);});",
                  "  if(body[0].jwtToken){pm.environment.set(\"enrollment.prospectJwt\",body[0].jwtToken);pm.collectionVariables.set(\"enrollment.prospectJwt\",body[0].jwtToken);}",
                  "}"
                ],
                "type": "text/javascript"
              },
              "listen": "test"
            }
          ],
