                  "var item = (pm.response.json()._embedded || {}).item || {};",
                  "var clean = {};",
                  "Object.keys(item).forEach(function (k) { if (k.charAt(0) !== '_' && k !== 'encryptedAesKey') { clean[k] = item[k]; } });",
                  "pm.environment.set('ownerPutBody', JSON.stringify([clean]));"
                ],
