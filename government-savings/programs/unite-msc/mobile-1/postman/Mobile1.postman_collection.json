  "event": [
    {
      "script": {
        "exec": [
          "var url = pm.request.url.toString();",
          "var isAnon = /mobilemembersession|mobilememberidptoken|mobilecsrasmembersession|validateBiometricToken|openapi|health|coreservicehealth/.test(url);",
          "if (!isAnon && !pm.environment.get('jwtToken')) {",
          "    console.warn('No {{jwtToken}} set yet. Run 00 - Auth > Login first.');",
          "}"
        ],
        "type": "text/javascript"
      },
      "listen": "prerequest"
    },
    {
      "script": {
        "exec": [
          "pm.test('Responded within 30s', function () { pm.expect(pm.response.responseTime).to.be.below(30000); });",
          "pm.test('No 5xx server error', function () { pm.expect(pm.response.code).to.be.below(500); });",
          "var name = (pm.info.requestName || '').toLowerCase();",
          "var skipSuccess = /acceptance-only|csr-only|biometric-only|idp-login-only|password-change/.test(name);",
          "if (!skipSuccess) {",
          "    pm.test('Success status (2xx)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 204]); });",
          "} else if (/acceptance-only/.test(name)) {",
          "    pm.test('Acceptance-only endpoint returns 401 as expected', function () { pm.expect(pm.response.code).to.equal(401); });",
          "}"
        ],
        "type": "text/javascript"
      },
      "listen": "test"
    }
  ]
